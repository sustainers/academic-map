{
  "aliveStatusCodes": [0,200,202,403,415],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "10s",
  "replacementPatterns": [
    {
      "pattern": "^https://github\\.com/sustainers/academic-map/(blob|tree)/main/",
      "replacement": "{{BASEURL}}/",
      "reason": "Check links to this repo's own files against the checkout instead of github.com, which 503s under load"
    }
  ],
  "ignorePatterns": [
    {
      "pattern": "^https://www\\.nsf\\.gov/awardsearch/show-award/",
      "reason": "NSF award pages return 200 for any ID, so checking them proves nothing, and the ~160 on the POSE page take most of the CI time limit. The IDs come from the NSF Award API."
    },
    {
      "pattern": "linkedin"
    },
    {
      "pattern": "^https://www.uni.lu/*"
    },
    {
      "pattern": "https://researchcomputing.syr.edu/ospo"
    },
    {
      "pattern": "https://artsandsciences.syracuse.edu/people/faculty/collin-capano/"
    },
    {
      "pattern": "https://www.umass.edu/opensource/content/mission.html"
    },
    {
      "pattern": "https://doi.org/10.7910/DVN/TJCLKP",
      "reason": "503"
    },
    {
      "pattern": "https://ospoplusplus.com"
    },
    {
      "pattern": "https://osf.io/institutions/gwu",
      "reason": "500"
    },
    {
      "pattern": "https://opsci.io",
      "reason": "402"
    },
    {
      "pattern": "https://commons.opsci.io/",
      "reason": "402"
    },
    {
      "pattern": "https://ospo.library.jhu.edu/",
      "reason": "500"
    },
    {
      "pattern": "https://www.esa.org/",
      "reason": "307"
    },
    {
      "pattern": "https://www.ieee.org/",
      "reason": "418"
    },
    {
      "pattern": "https://home.cern/science/computing/",
      "reason": "500"
    },
    {
      "pattern": "https://www.opensource.science/",
      "reason": "404"
    }
  ]
}
