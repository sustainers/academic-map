{
  "name": "academic-map",
  "private": true,
  "version": "1.0.0",
  "description": "An ecosystem map for academic OSS",
  "scripts": {
    "build": "jupyter-book build --all .",
    "prebuild": "npm run check-toc",
    "publish": "./scripts/build.sh",
    "lint": "markdownlint . -i _build/ -i node_modules --rules markdownlint-custom-rules.js",
    "lint-fix": "markdownlint --fix . -i _build/ -i node_modules",
    "links": "find . -name '*.md' -not -path './node_modules/*' -not -path './_build/*' -not -path './.git/*' -print0 | xargs -0 markdown-link-check -c mdlinkcheckconfig.json",
    "links-ci": "find . -name '*.md' -not -path './node_modules/*' -not -path './_build/*' -not -path './.git/*' -print0 | xargs -0 markdown-link-check -q -c mdlinkcheckconfig.json",
    "check-toc": "./scripts/check-toc-completeness.sh",
    "checks": "npm run lint && npm run links-ci && npm run check-toc",
    "pretest": "npm run lint-fix"
  },
  "devDependencies": {
    "markdown-link-check": "^3.12.2",
    "markdownlint": "^0.40.0"
  },
  "dependencies": {
    "markdownlint-rule-helpers": "^0.28.0"
  }
}
